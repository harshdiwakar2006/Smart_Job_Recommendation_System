{
  "version": 2,
  "buildCommand": "python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "authentication/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "authentication/wsgi.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "authentication/wsgi.py"
    }
  ]
}
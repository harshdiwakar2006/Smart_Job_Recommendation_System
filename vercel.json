{
  "version": 2,
  "builds": [
    {
      "src": "authentication/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "staticfiles/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "^/login$",
      "status": 308,
      "dest": "/login/"
    },
    {
      "src": "^/register/$",
      "status": 308,
      "dest": "/register"
    },
    {
      "src": "/(.*)",
      "dest": "authentication/wsgi.py"
    }
  ]
}
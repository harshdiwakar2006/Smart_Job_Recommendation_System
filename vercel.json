{
  "version": 2,
  "buildCommand": "python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "authentication/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "authentication/wsgi.py": {
      "maxDuration": 60,
      "includeFiles": "templates/**"
    }
  },
  "routes": [
    {
      "src": "^/login$",
      "status": 308,
      "dest": "/login/"
    },
    {
      "src": "^/register/$",
      "status": 308,
      "dest": "/register"
    },
    {
      "src": "/(.*)",
      "dest": "authentication/wsgi.py"
    }
  ]
}